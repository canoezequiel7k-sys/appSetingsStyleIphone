<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".redmobile.DisplayReadMobileActivity"
    android:background="@color/bg_screen">

    <include
        android:id="@+id/includedHeader"
        layout="@layout/layout_custom_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="30dp"/>

    <include
        android:id="@+id/includedContainer"
        layout="@layout/layout_info_card_red_mobile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/includedHeader"
        android:layout_marginTop="25dp"/>

    <include
        android:id="@+id/includedStates"
        layout="@layout/layout_setting_row_red_mobile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/includedContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/textConsejo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/textConsejo"
        android:textColor="@color/text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/includedStates"
        android:layout_marginTop="5dp"
        android:layout_marginHorizontal="30dp"/>

    <TextView
        android:id="@+id/textMovistar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Movistar"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textConsejo"
        android:layout_marginTop="15dp"
        android:layout_marginHorizontal="30dp"/>

    <include
        android:id="@+id/includedOperatorCard"
        layout="@layout/layout_card_operator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textMovistar"
        android:layout_marginTop="5dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>